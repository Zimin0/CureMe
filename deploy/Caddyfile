# Журналы Caddy (в них бывают IP-адреса посетителей) пишем в файл и стираем по времени:
# Политика обещает хранить веб-журналы не более 30 дней, а ротация по размеру этого не гарантирует.
{
	log {
		output file /data/logs/caddy.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}
}

# Caddy сам получает и продлевает сертификат Let's Encrypt для домена.
{$CUREME_DOMAIN} {
	encode zstd gzip
	# фото лекарств до 8 МБ
	request_body {
		max_size 10MB
	}
	header {
		# HSTS: браузер ходит на сайт только по HTTPS, даже если набрать http:// (защита от подмены в чужом Wi-Fi)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:8000
}

# www и дополнительные адреса из CUREME_OLD_DOMAIN (старый sslip.io, kapsulka.online) навсегда перенаправляем на основной домен,
# чтобы у приложения был один адрес: вход и установка на телефон привязаны к адресу сайта.
www.{$CUREME_DOMAIN} {$CUREME_OLD_DOMAIN} {
	redir https://{$CUREME_DOMAIN}{uri} permanent
}
