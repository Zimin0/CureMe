# Журналы Caddy (в них бывают IP-адреса посетителей) пишем в файл и стираем по времени:
# Политика обещает хранить веб-журналы не более 30 дней, а ротация по размеру этого не гарантирует.
{
	log {
		output file /data/logs/caddy.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}
}

# Caddy сам получает и продлевает сертификат Let's Encrypt для домена.
{$CUREME_DOMAIN} {
	encode zstd gzip
	# фото лекарств до 8 МБ
	request_body {
		max_size 10MB
	}
	header {
		# HSTS: браузер ходит на сайт только по HTTPS, даже если набрать http:// (защита от подмены в чужом Wi-Fi)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:8000
}

# www и дополнительные адреса из CUREME_OLD_DOMAIN (старый sslip.io, kapsulka.online) навсегда перенаправляем на основной домен,
# чтобы у приложения был один адрес: вход и установка на телефон привязаны к адресу сайта.
www.{$CUREME_DOMAIN} {$CUREME_OLD_DOMAIN} {
	redir https://{$CUREME_DOMAIN}{uri} permanent
}

# Тестовый стенд (staging): та же машина, но свой стек приложения и своя база (docker-compose.staging.yml).
# Закрыт паролем и от поисковиков.
# Переменные приходят из docker-compose.prod.yml; пока STAGING_AUTH_HASH не задан в .env, там стоит хеш
# случайного пароля, который никто не знает: стенд закрыт для всех, а на прод это никак не влияет.
{$STAGING_DOMAIN:dev-kapsulka.ru} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	basic_auth {
		{$STAGING_AUTH_USER:staging} {$STAGING_AUTH_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	reverse_proxy staging-app:8000
}

www.{$STAGING_DOMAIN:dev-kapsulka.ru} {
	redir https://{$STAGING_DOMAIN:dev-kapsulka.ru}{uri} permanent
}
